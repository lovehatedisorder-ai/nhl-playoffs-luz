<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LUZ STUDIO | NHL 2026</title>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        body { background-color: #000; color: #fff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
        .luz-font { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 700; }
        input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useRef } = React;

        const INITIAL_TEAMS = {
            west: [
                { id: 'w1', t1: 'Avalanche', city1: 'Colorado', t2: 'Kings', city2: 'Los Angeles', s1: 0, s2: 0, seed1: 1, seed2: 4, icon1: '🏔️', icon2: '👑' },
                { id: 'w2', t1: 'Stars', city1: 'Dallas', t2: 'Wild', city2: 'Minnesota', s1: 0, s2: 0, seed1: 2, seed2: 3, icon1: '⭐', icon2: '🌲' },
                { id: 'w3', t1: 'Golden Knights', city1: 'Vegas', t2: 'Mammoth', city2: 'Colorado', s1: 0, s2: 0, seed1: 1, seed2: 4, icon1: '⚔️', icon2: '🦣' },
                { id: 'w4', t1: 'Oilers', city1: 'Edmonton', t2: 'Ducks', city2: 'Anaheim', s1: 0, s2: 0, seed1: 2, seed2: 3, icon1: '💧', icon2: '🦆' },
            ],
            east: [
                { id: 'e1', t1: 'Sabres', city1: 'Buffalo', t2: 'Bruins', city2: 'Boston', s1: 0, s2: 0, seed1: 1, seed2: 4, icon1: '⚔️', icon2: 'Bear' },
                { id: 'e2', t1: 'Lightning', city1: 'Tampa Bay', t2: 'Canadiens', city2: 'Montréal', s1: 0, s2: 0, seed1: 2, seed2: 3, icon1: '⚡', icon2: '🇨🇦' },
                { id: 'e3', t1: 'Hurricanes', city1: 'Carolina', t2: 'Senators', city2: 'Ottawa', s1: 0, s2: 0, seed1: 1, seed2: 4, icon1: '🌀', icon2: '🛡️' },
                { id: 'e4', t1: 'Penguins', city1: 'Pittsburgh', t2: 'Flyers', city2: 'Philadelphia', s1: 0, s2: 0, seed1: 2, seed2: 3, icon1: '🐧', icon2: '🧡' },
            ]
        };

        function App() {
            const [userName, setUserName] = useState('');
            const [round1, setRound1] = useState(INITIAL_TEAMS);
            const bracketRef = useRef(null);

            const handleScoreChange = (side, seriesId, teamIndex, value) => {
                const score = Math.min(4, Math.max(0, parseInt(value) || 0));
                setRound1(prev => ({
                    ...prev,
                    [side]: prev[side].map(s => s.id === seriesId ? { ...s, [`s${teamIndex}`]: score } : s)
                }));
            };

            const exportAsImage = async () => {
                const canvas = await html2canvas(bracketRef.current, { backgroundColor: '#000000', scale: 2 });
                const link = document.createElement('a');
                link.href = canvas.toDataURL("image/png");
                link.download = `LUZ-2026-${userName || 'bracket'}.png`;
                link.click();
            };

            const TeamRow = ({ name, city, score, seed, icon, isWinner, isHabs, onChange }) => (
                <div className={`flex items-center justify-between p-3 rounded-lg ${isWinner ? 'bg-[#E3FC00]/20' : 'bg-black/40'}`}>
                    <div className="flex items-center gap-3">
                        <span className="text-[10px] font-bold text-zinc-600 w-4">{seed}</span>
                        <div className="flex flex-col">
                            <span className={`text-lg font-black leading-none ${isHabs ? 'text-[#AF1E2D]' : 'text-white'} ${isWinner ? 'text-[#E3FC00]' : ''}`}>
                                {name.toUpperCase()}
                            </span>
                            <span className="text-[9px] font-bold text-zinc-500 uppercase tracking-widest mt-1">{city}</span>
                        </div>
                    </div>
                    <input 
                        type="number" 
                        value={score} 
                        onChange={(e) => onChange(e.target.value)}
                        className={`w-12 h-10 bg-black border-2 rounded text-center text-xl font-bold ${isWinner ? 'border-[#E3FC00] text-[#E3FC00]' : 'border-zinc-800 text-zinc-400'}`}
                    />
                </div>
            );

            return (
                <div className="p-4 md:p-10 max-w-6xl mx-auto">
                    <header className="flex flex-col md:flex-row justify-between items-end mb-10 gap-6">
                        <div>
                            <div className="text-5xl luz-font tracking-tighter mb-2">LUZ STUDIO</div>
                            <div className="bg-[#AF1E2D] text-white text-[10px] px-2 py-1 font-black italic rounded">NHL PLAYOFFS 2026</div>
                        </div>
                        <input 
                            type="text" 
                            placeholder="VOTRE NOM" 
                            className="bg-zinc-900 border-2 border-zinc-800 p-4 rounded-xl text-xl font-bold text-[#E3FC00] w-full md:w-80 outline-none focus:border-[#E3FC00]"
                            onChange={(e) => setUserName(e.target.value)}
                        />
                    </header>

                    <button onClick={exportAsImage} className="bg-[#E3FC00] text-black font-black px-8 py-4 rounded-xl uppercase mb-8 hover:scale-105 transition-transform">
                        Sauvegarder vos prédictions
                    </button>

                    <div ref={bracketRef} className="bg-zinc-950 p-8 rounded-[30px] border border-zinc-900 shadow-2xl relative">
                        <div className="flex justify-between items-end mb-12 border-b border-zinc-900 pb-6">
                            <div>
                                <div className="text-[#E3FC00] text-[10px] font-black tracking-[0.3em] uppercase">Prédictions de</div>
                                <div className="text-5xl font-black italic uppercase tracking-tighter">{userName || "Anonyme"}</div>
                            </div>
                            <div className="text-6xl font-black text-zinc-900">2026</div>
                        </div>

                        <div className="grid grid-cols-1 md:grid-cols-2 gap-12">
                            {/* OUEST */}
                            <div className="space-y-6">
                                <div className="flex items-center gap-3">
                                    <div className="bg-[#192168] px-4 py-2 font-black italic text-2xl rounded">OUEST</div>
                                    <div className="h-px bg-zinc-800 flex-grow"></div>
                                </div>
                                {round1.west.map(s => (
                                    <div key={s.id} className="bg-zinc-900 p-4 rounded-xl border-l-4 border-[#192168] space-y-4">
                                        <TeamRow name={s.t1} city={s.city1} score={s.s1} seed={s.seed1} isWinner={s.s1 === 4} onChange={(v) => handleScoreChange('west', s.id, 1, v)} />
                                        <TeamRow name={s.t2} city={s.city2} score={s.s2} seed={s.seed2} isWinner={s.s2 === 4} onChange={(v) => handleScoreChange('west', s.id, 2, v)} />
                                    </div>
                                ))}
                            </div>

                            {/* EST */}
                            <div className="space-y-6">
                                <div className="flex items-center gap-3 justify-end">
                                    <div className="h-px bg-zinc-800 flex-grow"></div>
                                    <div className="bg-[#AF1E2D] px-4 py-2 font-black italic text-2xl rounded">EST</div>
                                </div>
                                {round1.east.map(s => (
                                    <div key={s.id} className="bg-zinc-900 p-4 rounded-xl border-r-4 border-[#AF1E2D] space-y-4">
                                        <TeamRow name={s.t1} city={s.city1} score={s.s1} seed={s.seed1} isWinner={s.s1 === 4} isHabs={s.t1 === 'Canadiens'} onChange={(v) => handleScoreChange('east', s.id, 1, v)} />
                                        <TeamRow name={s.t2} city={s.city2} score={s.s2} seed={s.seed2} isWinner={s.s2 === 4} isHabs={s.t2 === 'Canadiens'} onChange={(v) => handleScoreChange('east', s.id, 2, v)} />
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
